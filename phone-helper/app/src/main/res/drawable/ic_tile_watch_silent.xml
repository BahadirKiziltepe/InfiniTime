    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,1.5 L15,1.5 L15.6,5.6 L8.4,5.6 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.4,18.4 L15.6,18.4 L15,22.5 L9,22.5 Z" />
    <!-- The case, as a ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M5,12 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z M7,12 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
    <!-- Struck through -->
    <path
        android:pathData="M3.5,3.5 L20.5,20.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
