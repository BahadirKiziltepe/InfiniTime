<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the watch, and find it the first time. Never used to work out where the phone is. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Download watch builds from this project's GitHub releases page, and ask Spotify's web
         service for the playlists and the queue. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keep the phone awake for the few seconds it takes to answer the watch when it asks for a list. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Ask Android not to put the app to sleep, so the watch stays connected. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Ordinary phone calls. All four are asked for on the app's screen, and calls made through
         apps such as WhatsApp work without any of them.
         Phone state: to know that the phone is ringing or in a call.
         Answer calls: to answer or hang up when the watch asks for it.
         Call log: Android only gives the number that is calling to apps allowed to see call logs.
         Contacts: to show the caller's name instead of the number. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Start a call to one of the people chosen for the watch, when the watch asks for it. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Turn the volume of a call up or down from the watch. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The sound button on the watch switches the phone between sound, vibrate and mute. Android
         ties going to mute, and back, to Do Not Disturb, which takes this. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Find my phone: the phone vibrates as well as rings. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The weather on the watch is the weather where the phone is. Only the rough position is
         asked for; it is rounded to about a kilometre, sent to the weather service and nowhere
         else, and never written to the log or the report. "Background" is what Android calls
         looking while the app's screen is closed, which is when the watch asks. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Since Android 17 an app may only change a volume or the sound mode, or make a sound, in
         the background while it runs a foreground service. See LinkService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Calls are an extra. The app is just as useful on a device without a phone in it. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <!-- Read the names of the pictures on Spotify's player buttons, for the report. -->
        <package android:name="com.spotify.music" />
        <!-- Warn when Gadgetbridge is still around: two apps would act on the same watch buttons. -->
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
        <!-- Read the small icon of Claude's notifications, which the watch shows next to its battery numbers. -->
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The "Back to Watch Helper" link on the page the browser shows after the Spotify login. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="spotify-login"
                    android:scheme="watchhelper" />
            </intent-filter>
        </activity>

        <!-- Notification access is what allows an app to see other apps' media players. It is also
             used for what its name says: notifications from the messaging apps listed in
             NotificationRelay, and call notifications, are passed on to the watch. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Keeps the app in the state Android 17 demands before it lets an app change the volume
             or the sound mode, or ring, while its screen is closed. It does nothing else. -->
        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Sends a watch build to the watch. Only ever started by this app. -->
        <service
            android:name=".UpdateService"
            android:exported="false" />
    </application>

</manifest>
